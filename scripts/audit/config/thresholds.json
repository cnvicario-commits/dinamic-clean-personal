{
  "god_class": {
    "loc_watch": 600,
    "loc_high": 1000,
    "methods_high": 20,
    "deps_high": 10,
    "imports_high": 8,
    "complex_methods_high": 8,
    "score_ok": 5,
    "score_watch": 9,
    "score_medium": 14,
    "score_high": 20
  },
  "complexity": {
    "file_loc_warn": 800,
    "file_loc_high": 1200,
    "control_flow_token_density_high": 80
  },
  "architecture": {
    "forbidden_import_patterns": [
      {
        "from_glob": "apps/api/src/http/**",
        "to_pattern": "infrastructure/db",
        "rule": "http-must-not-import-db-infrastructure",
        "severity": "high",
        "confidence": "medium",
        "status": "requires-review"
      },
      {
        "from_glob": "apps/api/src/application/**",
        "to_pattern": "fastify",
        "rule": "application-must-not-import-fastify",
        "severity": "high",
        "confidence": "high",
        "status": "detected"
      },
      {
        "from_glob": "src/**",
        "to_pattern": "apps/api",
        "rule": "frontend-must-not-import-api-package",
        "severity": "critical",
        "confidence": "high",
        "status": "detected",
        "blocking": true,
        "match_mode": "case_insensitive_contains"
      }
    ]
  },
  "sql": {
    "risk_layers": ["http", "application"],
    "flag_service_executable_sql": true
  },
  "gate": {
    "block_severities": ["critical"],
    "block_high_with_confidence": ["high"],
    "ignore_statuses": ["accepted-risk", "false-positive"]
  },
  "scan_roots": ["apps/api/src", "src"],
  "exclude_globs": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/build/**",
    "**/.git/**",
    "**/.next/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.integration.test.ts",
    "**/lib/api/generated/**"
  ],
  "scanner_coverage": {
    "framework": [
      "architecture",
      "god-classes",
      "complexity",
      "sql",
      "solid",
      "grasp",
      "patches",
      "exceptions",
      "reliability",
      "env-consistency"
    ],
    "legacy": [
      "npm audit",
      "secrets",
      "env documentation",
      "line-length",
      "db-forward-migrations",
      "backend/frontend lint/typecheck/test/build"
    ]
  }
}
