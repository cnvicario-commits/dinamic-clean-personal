# Copy to /opt/dinamic-clean-cristian/.env on the VPS. Never commit the copy.
# Do not reuse the production env file. Do not put a migrations password here.

NODE_ENV=production
APP_DEPLOYMENT_ENV=cristian-pruebas
EXPECTED_SUPABASE_PROJECT_REF=edruejzwwnixsjsadbgb
APP_RELEASE_SHA=replace-with-git-sha

HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Browser origin for the Cristian HTTP publication. No wildcard.
# HTTP does not protect credentials, cookies, or tokens. Use test accounts only.
# A future HTTPS origin can replace this single value. Do not add a second origin.
CORS_ORIGIN=http://170.239.85.196:8086

# dinamic_api on Supabase Test (edruejzwwnixsjsadbgb). Not the postgres role.
DATABASE_URL=postgresql://dinamic_api.edruejzwwnixsjsadbgb:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://edruejzwwnixsjsadbgb.supabase.co

# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Host Nginx connects from loopback. Do not set 0.0.0.0/0.
TRUST_PROXY_CIDRS=127.0.0.1

SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_ENABLED=true
