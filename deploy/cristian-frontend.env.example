# Variables for the Cristian frontend. Do not commit real values.
# Do not copy the API env: it contains the database URL and the service role.
# NEXT_PUBLIC_* are baked into the browser bundle at image build.
# Changing them afterwards does not change an image that was already built.

APP_RELEASE_SHA=replace-with-git-sha
APP_DEPLOYMENT_ENV=cristian-pruebas

CRISTIAN_NEXT_PUBLIC_SUPABASE_URL=https://edruejzwwnixsjsadbgb.supabase.co
CRISTIAN_NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Baked into the browser bundle. HTTP exposes tokens to the network.
# A future HTTPS origin remains valid for a new image build.
CRISTIAN_NEXT_PUBLIC_API_URL=http://170.239.85.196:3006

# Runtime inside the Compose network. The browser must not use this value.
API_URL=http://dinamic-clean-cristian-api:3001

# 8086 was free at the last survey. Confirm it again before publishing.
CRISTIAN_FRONTEND_HOST_PORT=8086
CRISTIAN_FRONTEND_CPUS=
CRISTIAN_FRONTEND_MEMORY=
