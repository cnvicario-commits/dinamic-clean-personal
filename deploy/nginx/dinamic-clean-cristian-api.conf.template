# Render with deploy/render-cristian-nginx.sh. Tokens are not nginx variables.
# Install only as a new site. Do not replace a production server block.

server {
  listen 80;
  server_name __DEMO_API_DOMAIN__;
  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name __DEMO_API_DOMAIN__;

  ssl_certificate /etc/letsencrypt/live/__DEMO_API_DOMAIN__/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/__DEMO_API_DOMAIN__/privkey.pem;

  client_max_body_size 22m;
  proxy_connect_timeout 5s;
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;

  location / {
    proxy_pass http://127.0.0.1:__CRISTIAN_API_HOST_PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
  }
}
