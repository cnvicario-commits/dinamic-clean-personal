# Copy to apps/api/.env — never commit real values

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Postgres — prefer least-privilege role `dinamic_api` on TEST (not production yet).
# Create role: psql "$TEST_ADMIN_URL" -f ../../supabase/ops/create_api_role.sql
# Then set password out-of-band (never commit):
#   ALTER ROLE dinamic_api PASSWORD '...';
# Docs: docs/phase-1-db-least-privilege.md
# Verify with: select current_user;
DATABASE_URL=postgresql://dinamic_api:PASSWORD@HOST:5432/postgres

# Supabase project URL — used for JWKS JWT verification:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Issuer expected: {SUPABASE_URL}/auth/v1
# Audience expected: authenticated
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Optional HS256 fallback when JWKS is unreachable or project still uses legacy HMAC.
# Prefer JWKS in production. Required for offline unit/integration JWT tests.
# Never expose via NEXT_PUBLIC_*.
# SUPABASE_JWT_SECRET=

# Graceful shutdown budget (ms) before forced process.exit(1). Default 10000.
SHUTDOWN_TIMEOUT_MS=10000
