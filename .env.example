# Copy to `.env.local` at repo root — never commit real values.
# Next.js loads these for the frontend and server components / Route Handlers.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Browser client (`src/lib/api/browser.ts`) — required for client-side API calls.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional server-only alias for BFF pages and Route Handlers when not using NEXT_PUBLIC_*.
# Falls back to NEXT_PUBLIC_API_URL when unset (`src/app/**`, `src/app/api/**`).
API_URL=http://localhost:3001
